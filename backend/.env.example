# Copy to .env and fill in. Commented-out lines are optional: each shows the default, or an example when the default is unset.
# Variables the app does not know are ignored.

# --- Database
# Postgres URL; the database needs the pgvector extension
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studentsai_db

# --- Auth tokens
# Key that signs access and email tokens; a long random string
SECRET_KEY=change-me
# JWT signing algorithm
# ALGORITHM=HS256
# Access token lifetime in minutes
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# Email verification link lifetime in minutes
# VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# --- Email, sent through the SendGrid Web API
# SendGrid API key
SENDGRID_API_KEY=your-sendgrid-api-key
# Sender address, verified in SendGrid
MAIL_FROM=you@example.com
# Sender display name, not yet passed to SendGrid
# MAIL_FROM_NAME=StudentsAI

# --- Google sign-in
# OAuth client ID from the Google Cloud console
GOOGLE_CLIENT_ID=your-google-client-id
# OAuth client secret from the Google Cloud console
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Redirect URI registered for the OAuth client
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- App
# Frontend origin, used in email links and allowed for CORS with and without www
FRONTEND_URL=http://localhost:3000
# API docs, error details in responses and no rate limits; false in production
DEBUG=true
# Interface `python -m app.main` binds to
# HOST=0.0.0.0
# Port `python -m app.main` listens on
# PORT=8000
# CORS origins allowed besides FRONTEND_URL, as a JSON list; defaults to the production and local origins
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# The same as a comma-separated string; the two lists are merged
# ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limits, per user or per IP when signed out
# Requests allowed per window
# RATE_LIMIT_REQUESTS=100
# Window length in seconds
# RATE_LIMIT_WINDOW=3600
# Model-backed requests allowed per hour
# AI_REQUESTS_PER_HOUR=100

# --- Language model
# fake, openai or anthropic; fake answers locally and costs nothing
LLM_PROVIDER=fake
# OpenAI API key, used when LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# Anthropic API key, used when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Model ID; unset means the provider's cheapest adequate model
# LLM_MODEL=claude-haiku-5-5
# OpenAI-compatible base URL, for example a self-hosted vLLM or Ollama server; unset means the provider's API
# LLM_BASE_URL=http://localhost:11434/v1
# Seconds before a model request times out
# LLM_TIMEOUT_SECONDS=120
# Retries the provider SDK makes on transient errors
# LLM_MAX_RETRIES=2
# Reasoning effort sent to the provider; unset means the model's default
# LLM_REASONING_EFFORT=low

# --- Note similarity and embeddings
# tfidf or embeddings; how the note graph finds similar notes
# SIMILARITY_BACKEND=tfidf
# fastembed runs a local model on CPU; fake is for tests
# EMBEDDING_BACKEND=fastembed
# Local embedding model, downloaded on first use
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Directory for downloaded embedding models
# EMBEDDING_CACHE_DIR=~/.cache/fastembed
# Cosine similarity above which two notes connect with the embeddings backend
# EMBEDDING_SIMILARITY_THRESHOLD=0.7

# --- Concepts
# Concept names more similar than this merge into one concept
# CONCEPT_DEDUP_THRESHOLD=0.93
# Concepts more similar than this are linked as related
# CONCEPT_RELATED_THRESHOLD=0.8
# Most prerequisites kept per concept
# CONCEPT_MAX_PREREQUISITES=2
# Chunks sent to the model at once during extraction
# CONCEPT_EXTRACTION_CONCURRENCY=4

# --- Tutor
# Below this question-to-material similarity, Ask answers that the material does not cover the question
# ASK_MIN_SIMILARITY=0.5

# --- Documents
# Directory for uploaded documents; unset means backend/storage/documents
# DOCUMENT_STORAGE_DIR=/var/lib/studentsai/documents
# Largest accepted upload in bytes (25 MiB)
# MAX_DOCUMENT_BYTES=26214400
